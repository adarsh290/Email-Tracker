# Email Configuration
EMAIL_ACCOUNT="your_college_email@example.com"
EMAIL_APP_PASSWORD="your_app_password"
IMAP_SERVER="imap.gmail.com" # Change if not using Gmail/Google Workspace

# Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key"
IMPORTANCE_PROMPT="You are an intelligent email assistant for a college student. Categorize the given email into one of the following priorities: High, Mid, Low, or Spam.\nUse the following strict criteria:\n- High: Exam marks/results, any assignment or project submissions, updates from 'Upstop' (regarding competitions, not spam/promotions).\n- Mid: Club sessions, changes in the mess menu, any event or fest related details.\n- Low: Seminars offering complimentary snacks, or any other email that you deem genuinely important but not urgent.\n- Spam: Everything else, including items for sale/buy, lost & found, general university noise, promotional emails, etc. (Spam will be ignored and not sent).\nRespond with a structured JSON object containing the priority, extracted deadline, and a brief summary."

# Discord Configuration
DISCORD_BOT_TOKEN="your_discord_bot_token"

# Discord Channel IDs (Right-click channel in Discord -> Copy Channel ID)
CHANNEL_HIGH_PRIORITY="1234567890123456789"
CHANNEL_MID_PRIORITY="1234567890123456789"
CHANNEL_LOW_PRIORITY="1234567890123456789"
CHANNEL_SUMMARIES="1234567890123456789"

# Fetch Settings
# Date format: DD-Mon-YYYY (e.g., 20-Dec-2025). Leave blank to only fetch new unread emails.
FETCH_SINCE_DATE="20-Dec-2025"
POLL_INTERVAL_SECONDS=300
